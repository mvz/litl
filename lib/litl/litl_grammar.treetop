grammar LitlGrammar
  rule expression
    space? '(' identifier body ')' space? <Litl::Expression>
  end

  rule identifier
    [a-zA-Z] [a-zA-Z0-9]* <Litl::Identifier>
  end

  rule space
    [\s]+
  end

  rule body
    (expression / literal / space)* <Litl::Body>
  end

  rule literal
    identifier (space identifier)* <Litl::Literal>
  end
end
